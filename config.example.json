{
  "_说明": "通常不需要手动编辑本文件：第一次使用时 Agent 会询问并自动生成 ~/.anhui-legal-radar/config.json；也可用 radar channel add 添加渠道。*_env 字段是密钥名称，密钥本身用 radar secret set <名称> 录入，或设置同名环境变量。",
  "daily": {
    "days": 30,
    "depth": "standard",
    "court_limit": 600,
    "push_when_empty": false
  },
  "keywords": {},
  "web_search": {
    "backend": "bocha",
    "enabled": false,
    "api_key_env": "BOCHA_API_KEY",
    "max_leads": 60
  },
  "channels": [
    {
      "type": "dingtalk",
      "name": "钉钉群机器人",
      "enabled": false,
      "webhook_env": "RADAR_DINGTALK_WEBHOOK",
      "secret_env": "RADAR_DINGTALK_SECRET"
    },
    {
      "type": "wecom",
      "name": "企业微信群机器人",
      "enabled": false,
      "webhook_env": "RADAR_WECOM_WEBHOOK"
    },
    {
      "type": "feishu",
      "name": "飞书群机器人",
      "enabled": false,
      "webhook_env": "RADAR_FEISHU_WEBHOOK",
      "secret_env": "RADAR_FEISHU_SECRET"
    },
    {
      "type": "email",
      "name": "邮箱",
      "enabled": false,
      "smtp_host": "smtp.qq.com",
      "smtp_port": 465,
      "smtp_user": "your_account@qq.com",
      "smtp_password_env": "RADAR_SMTP_PASSWORD",
      "to": ["your_account@qq.com"]
    },
    {
      "type": "serverchan",
      "name": "微信（Server酱）",
      "enabled": false,
      "sendkey_env": "RADAR_SERVERCHAN_KEY"
    },
    {
      "type": "webhook",
      "name": "自定义 Webhook",
      "enabled": false,
      "url_env": "RADAR_CUSTOM_WEBHOOK"
    }
  ]
}
